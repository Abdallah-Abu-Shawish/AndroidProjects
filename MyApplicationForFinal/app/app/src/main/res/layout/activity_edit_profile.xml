<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".EditProfileActivity">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">





    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textSize="25sp"
        android:textStyle="bold"
        android:text="Edit Page"
        android:layout_marginTop="30dp"
        android:textColor="@color/black" />


        <androidx.cardview.widget.CardView

            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginStart="100dp"
            android:layout_marginBottom="10dp"
            app:cardCornerRadius="100dp"
            android:backgroundTint="#DFDFDF"
            android:layout_marginTop="20dp"
            android:background="@drawable/profile_img">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/profile_img_edited"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    />

                <ImageView
                    android:id="@+id/edit_img_profile_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/profile_img"
                    android:src="@drawable/ic_baseline_ios_share_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />


            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.cardview.widget.CardView>


        <TextView
        android:id="@+id/tv_name_show"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="Name"
        android:layout_marginTop="20dp"
        android:textColor="@color/black"
        android:layout_marginStart="40dp"/>

    <EditText
        android:id="@+id/edit_profile_name"
        android:layout_width="300dp"
        android:layout_height="40dp"
        android:background="@drawable/profile_info_shape"
        android:paddingStart="10dp"
        android:paddingTop="1dp"
        android:hint="Enter new name"
        android:layout_marginBottom="20dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginStart="40dp"/>

    <TextView
        android:id="@+id/tv_email_show"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="Email"
        android:textColor="@color/black"
        android:layout_marginStart="40dp"/>

    <EditText
        android:id="@+id/edit_profile_email"
        android:layout_width="300dp"
        android:layout_height="40dp"
        android:background="@drawable/profile_info_shape"
        android:paddingStart="10dp"
        android:paddingTop="1dp"
        android:hint="Enter new email"
        android:layout_marginBottom="20dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginStart="40dp"/>



    <TextView
        android:id="@+id/tv_username_show"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="Userame"
        android:textColor="@color/black"
        android:layout_marginStart="40dp"/>

    <EditText
        android:id="@+id/edit_profile_username"
        android:layout_width="300dp"
        android:layout_height="40dp"
        android:background="@drawable/profile_info_shape"
        android:paddingStart="10dp"
        android:paddingTop="1dp"
        android:hint="Enter new username"
        android:layout_marginBottom="20dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginStart="40dp"/>



    <TextView
        android:id="@+id/tv_password_show"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="Password"
        android:textColor="@color/black"
        android:layout_marginStart="40dp"/>


    <EditText
        android:id="@+id/edit_profile_password"
        android:layout_width="300dp"
        android:layout_height="40dp"
        android:background="@drawable/profile_info_shape"
        android:paddingStart="10dp"
        android:hint="Enter new password"
        android:paddingTop="1dp"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="40dp"/>

    <TextView
        android:id="@+id/tv_gender_show"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="Gender"
        android:textColor="@color/black"
        android:layout_marginStart="40dp"/>



    <RadioGroup
        android:id="@+id/edit_gender"
        android:layout_width="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="15dp"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/edit_gender_male"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Male"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginEnd="20dp"
            android:textColor="@color/black"/>

        <RadioButton
            android:id="@+id/edit_gender_female"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Female"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"/>



    </RadioGroup>

    <TextView
        android:id="@+id/tv_country_show"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="Country"
        android:textColor="@color/black"
        android:layout_marginStart="40dp"/>


    <EditText
        android:id="@+id/edit_profile_country"
        android:layout_width="300dp"
        android:layout_height="40dp"
        android:background="@drawable/profile_info_shape"
        android:paddingStart="10dp"
        android:hint="Enter new country name"
        android:paddingTop="1dp"
        android:textStyle="bold"
        android:textSize="20dp"
        android:layout_marginBottom="20dp"
        android:layout_marginStart="40dp"/>







    <Button
        android:id="@+id/btn_save_edit"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:layout_gravity="center"
        android:textColor="@color/white"
        android:text="Save Edits"
        android:layout_marginBottom="20dp"
        android:background="@drawable/btn_shape"
       />



</LinearLayout>


    </ScrollView>






    </LinearLayout>