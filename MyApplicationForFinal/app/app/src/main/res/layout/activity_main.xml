<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivityForHome">


<com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/tab_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="3dp"
            app:itemIconTint="@color/white"
            app:itemTextColor="@color/white"
            app:elevation="20dp"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            android:background="@drawable/tab_bar_shape"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:menu="@menu/my_bar_menu" />



<LinearLayout
    android:id="@+id/linear1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:orientation="horizontal"
    app:layout_constraintTop_toTopOf="parent">


<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
        android:textSize="30sp"
        android:textStyle="bold"
        android:text="Watches Shop"
        android:textColor="@color/black"
    android:background="@drawable/edit_text_shape"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="100dp"
        android:layout_marginStart="20dp"
        android:padding="10dp"/>

        <ImageView
            android:id="@+id/search_product"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_baseline_search_24_white"
                android:layout_marginTop="43dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/icon_shape"/>


</LinearLayout>


<ScrollView
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linear1">

<LinearLayout
    android:id="@+id/liner_for_gap"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
        android:orientation="vertical">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="23sp"
            android:text="Top Deals"
            android:layout_margin="20dp"/>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/H_offers"
            android:layout_width="match_parent"
            android:layout_height="140dp"/>



<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
       >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="23sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="Most popular"
            android:layout_marginTop="8dp"
            android:layout_marginStart="20dp"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="43dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="All"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="15dp"
            android:src="@drawable/ic_baseline_keyboard_arrow_down_24"
            android:layout_marginTop="8dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>






<androidx.recyclerview.widget.RecyclerView
    android:id="@+id/watches_List"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
   />

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:orientation="horizontal">

        </LinearLayout>
</LinearLayout>





</ScrollView>





</androidx.constraintlayout.widget.ConstraintLayout>