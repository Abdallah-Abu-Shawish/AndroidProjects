<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_row="5"
    android:layout_column="4"
    android:background="#63AFEC"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/tv_result"
        android:layout_width="410dp"
        android:layout_height="100dp"
        android:layout_row="1"
        android:layout_column="0"
        android:gravity="center"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="20dp"
        android:background="@drawable/result_shape"
        android:layout_columnSpan="4" />

    <Button
        android:id="@+id/clear_btn"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_column="3"
        android:layout_row="2"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="10dp"
        android:textSize="20sp"
        android:background="@drawable/button_shape"
        android:layout_margin="1dp"
        android:text="Clear"/>




    <Button
        android:id="@+id/btn_4"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_row="4"
        android:text="4"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="25sp"
        android:background="@drawable/button_shape"
        android:layout_margin="1dp"
        android:layout_column="0" />

    <Button
        android:id="@+id/btn_3"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_row="5"
        android:text="3"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="25sp"
        android:background="@drawable/button_shape"
        android:layout_margin="1dp"
        android:layout_column="2" />

    <Button
        android:id="@+id/btn_8"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_row="3"
        android:gravity="center"
        android:text="8"
        android:textStyle="bold"
        android:textSize="25sp"
        android:background="@drawable/button_shape"
        android:layout_margin="1dp"
        android:layout_column="1" />

    <Button
        android:id="@+id/btn_5"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_row="4"
        android:text="5"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="25sp"
        android:background="@drawable/button_shape"
        android:layout_margin="1dp"
        android:layout_column="1" />

    <Button
        android:id="@+id/btn_0"
        android:layout_width="209dp"
        android:layout_height="80dp"
        android:layout_row="6"
        android:layout_column="0"
        android:textStyle="bold"
        android:textSize="25sp"
        android:gravity="center"
        android:layout_columnSpan="2"
        android:background="@drawable/zero_shap"
        android:text="0" />

    <Button
        android:id="@+id/pius_btn"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_row="6"
        android:text="+"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="25sp"
        android:background="@drawable/operations_shape"
        android:layout_margin="1dp"
        android:layout_column="3" />

    <Button
        android:id="@+id/dive_btn"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_row="3"
        android:text="÷"
        android:gravity="center"
        android:background="@drawable/operations_shape"
        android:textStyle="bold"
        android:textSize="25sp"
        android:layout_margin="1dp"
        android:layout_column="3" />

    <Button
        android:id="@+id/mult_btn"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_row="4"
        android:text="×"
        android:gravity="center"
        android:background="@drawable/operations_shape"
        android:textStyle="bold"
        android:textSize="25sp"
        android:layout_margin="1dp"
        android:layout_column="3" />

    <Button
        android:id="@+id/minc_btn"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_row="5"
        android:text="-"
        android:gravity="center"
        android:textStyle="bold"
        android:background="@drawable/operations_shape"
        android:textSize="25sp"
        android:layout_margin="1dp"
        android:layout_column="3" />

    <Button
        android:id="@+id/btn_9"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_row="3"
        android:text="9"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="25sp"
        android:background="@drawable/button_shape"
        android:layout_margin="1dp"
        android:layout_column="2" />

    <Button
        android:id="@+id/btn_6"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_row="4"
        android:text="6"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="25sp"
        android:background="@drawable/button_shape"
        android:layout_margin="1dp"
        android:layout_column="2" />

    <Button
        android:id="@+id/btn_2"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_row="5"
        android:gravity="center"
        android:text="2"
        android:textStyle="bold"
        android:textSize="25sp"

        android:background="@drawable/button_shape"
        android:layout_margin="1dp"
        android:layout_column="1" />

    <Button
        android:id="@+id/btn_7"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_row="3"
        android:text="7"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="25sp"
        android:background="@drawable/button_shape"
        android:layout_margin="1dp"
        android:layout_column="0" />

    <Button
        android:id="@+id/btn_1"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_row="5"
        android:text="1"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="25sp"
        android:background="@drawable/button_shape"
        android:layout_margin="1dp"
        android:layout_column="0" />

    <Button
        android:id="@+id/equal_btn"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_row="6"
        android:text="="
        android:gravity="center"
        android:background="@drawable/operations_shape"
        android:textStyle="bold"
        android:textSize="25sp"
        android:layout_margin="1dp"
        android:layout_column="2" />




</GridLayout>