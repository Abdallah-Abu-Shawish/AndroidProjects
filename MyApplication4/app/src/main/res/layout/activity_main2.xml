<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity2">


    <View
        android:id="@+id/divider"
        android:layout_width="300dp"
        android:layout_height="4dp"
        android:layout_marginTop="60dp"
        android:background="?android:attr/listDivider"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="#03B0F5"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/img"
        android:layout_width="64dp"
        android:layout_height="61dp"
        android:layout_marginStart="172dp"
        android:src="@drawable/ic_baseline_calendar_month_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.041" />

    <TextView
        android:id="@+id/how_to_bay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="16dp"
        android:text="How to bay"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/card"
        app:layout_constraintTop_toBottomOf="@id/img" />

    <ImageView
        android:id="@+id/card"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/ic_baseline_credit_card_24"
        app:layout_constraintEnd_toStartOf="@id/how_to_bay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img" />


    <EditText
        android:id="@+id/text_money"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/shape_edit"
        android:drawableStart="@drawable/ic_baseline_money_24"
        android:drawablePadding="10dp"

        android:text="money"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/how_to_bay" />


    <Button
        android:id="@+id/visa_btn"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="168dp"
        android:background="@drawable/visa"
        android:text="VISA"
        android:textColor="@color/white"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/android"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:layout_margin="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/shape_edit"
        android:drawableStart="@drawable/ic_baseline_person_24"
        android:drawablePadding="10dp"
        android:hint="Android"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/visa_btn" />

    <EditText
        android:id="@+id/email"
        android:layout_width="300dp"
        android:layout_height="60dp"
        android:layout_margin="20dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/shape_edit"
        android:drawableStart="@drawable/ic_baseline_email_24"
        android:drawablePadding="10dp"
        android:hint="android@gmail.com"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.009"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/android" />

    <EditText
        android:id="@+id/date"
        android:layout_width="130dp"
        android:layout_height="60dp"
        android:layout_margin="20dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/shape_edit"
        android:drawableStart="@drawable/ic_baseline_calendar12_month_24"
        android:drawablePadding="10dp"
        android:hint="1/11/2022"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.014"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/email" />

    <EditText
        android:id="@+id/cvv"
        android:layout_width="130dp"
        android:layout_height="60dp"
        android:layout_margin="20dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/shape_edit"
        android:drawableStart="@drawable/ic_baseline_credit_card_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.144"
        app:layout_constraintStart_toEndOf="@id/date"
        android:hint="CVV"
        android:drawablePadding="10dp"
        app:layout_constraintTop_toBottomOf="@id/email" />


      <TextView
          android:id="@+id/payment"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintTop_toBottomOf="@id/date"
          android:layout_marginTop="40dp"
          android:layout_marginStart="20dp"
          android:textSize="20sp"
          android:textColor="@color/black"
          android:textStyle="bold"
          android:text="Payment"/>

    <View
        android:id="@+id/divider2"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="20dp"
        app:layout_constraintTop_toBottomOf="@id/payment"
        android:background="?android:attr/listDivider" />

    <TextView
        android:id="@+id/totle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider2"
        android:layout_margin="20dp"
        android:text="totle:"
        android:textSize="20sp"/>


    <TextView
        android:id="@+id/totle_money"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider2"
        android:layout_margin="20dp"
        android:text="$ 20.00"
        android:textSize="20sp"/>

    <TextView
        android:id="@+id/bay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/totle"
        android:layout_margin="20dp"
        android:text="bay:"
        android:textColor="#FF9800"
        android:textSize="20sp"/>



    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/totle_money"
        android:layout_margin="20dp"
        android:textColor="#FF9800"
        android:text="- $ 5.00"
        android:textSize="20sp"/>




    <View
        android:id="@+id/divider3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bay"
        android:layout_margin="20dp"
        android:background="?android:attr/listDivider" />
    <TextView
        android:id="@+id/totle2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider3"
        android:layout_margin="20dp"
        android:text="totle:"
        android:textStyle="bold"
        android:textSize="20sp"/>


    <TextView
        android:id="@+id/totle_money2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/divider3"
        android:layout_margin="20dp"
        android:text="$ 20.00"
        android:textStyle="bold"
        android:textSize="20sp"/>

    <Button
        android:layout_width="250dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="20dp"
        android:background="@drawable/button_shape"
        android:text="Confirm"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@color/white"/>








</androidx.constraintlayout.widget.ConstraintLayout>