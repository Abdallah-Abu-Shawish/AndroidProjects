<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".FinancialActivity">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Are you student or teacher?"
        android:textSize="20sp"
        android:layout_marginTop="60dp"
        android:layout_marginStart="30dp"

        />


    <RadioGroup
        android:id="@+id/rg_work"
        android:layout_width="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="30dp"
        android:layout_marginTop="20dp"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rb1_emp"
            android:layout_width="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_height="wrap_content"
            android:text="employee"/>

        <RadioButton
            android:id="@+id/rb2_stu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student"/>


    </RadioGroup>


    <TextView
        android:id="@+id/name1111"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="20sp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="30dp"

        />
    <TextView
        android:id="@+id/ys1111"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="20sp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="30dp"

        />


    <Button
        android:id="@+id/finantial_enter_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="140dp"
        android:layout_marginTop="50dp"
        android:background="@drawable/button_click"
        android:text="Enter data"/>



    <Button
        android:id="@+id/finantial_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="140dp"
        android:background="@drawable/button_click"
        android:layout_marginTop="50dp"
        android:text="Next"/>

</LinearLayout>