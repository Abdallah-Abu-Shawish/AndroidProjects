            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I liked Grilled Chicken thank you for this great meal it was so delicious"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="15dp"
                android:textSize="15sp"
                android:layout_marginBottom="15dp"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6d"

                    android:textColor="#111"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Like"
                    android:textSize="15sp"
                    android:textColor="#111"
                    android:layout_marginStart="20dp"
                    android:drawableStart="@drawable/ic_baseline_thumb_up_off_alt_24"
                    android:drawablePadding="5dp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reply"
                    android:textSize="15sp"
                    android:textColor="#111"
                    android:drawableStart="@drawable/ic_baseline_message_24"
                    android:layout_marginStart="20dp"
                    android:drawablePadding="5dp"/>




            </LinearLayout>


















        </LinearLayout>
























    </LinearLayout>


</LinearLayout>