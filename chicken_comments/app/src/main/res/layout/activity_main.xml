                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reply"
                    android:textSize="15sp"
                    android:textColor="#111"
                    android:drawableStart="@drawable/ic_baseline_message_24"
                    android:layout_marginStart="20dp"
                    android:drawablePadding="5dp"/>




            </LinearLayout>


















        </LinearLayout>
























    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/biden_circle"
            android:layout_marginTop="20dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Joe Biden"
                android:textStyle="bold"
                android:textColor="#111"
                android:textSize="19sp"
                android:layout_marginTop="20dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="I liked Grilled Chicken thank you for this great meal it was so delicious"
                android:layout_marginTop="7dp"
                android:layout_marginEnd="15dp"
                android:textSize="15sp"
                android:layout_marginBottom="15dp"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6d"
                    android:textColor="#111"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Like"
                    android:textSize="15sp"
                    android:textColor="#111"
                    android:layout_marginStart="20dp"
                    android:drawableStart="@drawable/ic_baseline_thumb_up_off_alt_24"
                    android:drawablePadding="5dp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reply"
                    android:textSize="15sp"
                    android:textColor="#111"
                    android:drawableStart="@drawable/ic_baseline_message_24"
                    android:layout_marginStart="20dp"
                    android:drawablePadding="5dp"/>




            </LinearLayout>


















        </LinearLayout>
























    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/tom_cruise"
            android:layout_marginTop="20dp"
            android:layout_marginStart="30dp"
