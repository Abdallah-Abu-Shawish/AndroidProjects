<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/orange"
    tools:context=".ReceiptActivity">


    <TextView
        android:id="@+id/tvvt_reciptPage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="30sp"
        android:textColor="@color/white"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:text="Recipt Page"/>


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="250dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        android:layout_marginHorizontal="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvvt_reciptPage">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="168dp">



            <TextView
                android:id="@+id/show_unitPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="25sp"
                app:layout_constraintStart_toEndOf="@id/tvvt_unitPrice"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="5dp"
                android:textColor="@color/black"
                android:layout_marginTop="15dp"
                android:text="Unit price:"/>

            <TextView
                android:id="@+id/show_quntity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="25sp"
                app:layout_constraintStart_toEndOf="@id/tvvt_quntity"
                app:layout_constraintTop_toBottomOf="@id/tvvt_unitPrice"
                android:layout_marginStart="5dp"
                android:layout_marginTop="20dp"
                android:textColor="@color/black"
                android:text="Quntity:"/>


            <TextView
                android:id="@+id/show_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="25sp"
                app:layout_constraintStart_toEndOf="@id/tvvt_total"
                app:layout_constraintTop_toBottomOf="@id/tvvt_quntity"
                android:layout_marginStart="5dp"
                android:layout_marginTop="20dp"
                android:textColor="@color/black"
                android:text="Total:"/>


            <TextView
                android:id="@+id/tvvt_unitPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="25sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="5dp"
                android:textColor="@color/black"
                android:layout_marginTop="15dp"
                android:text="Unit price:"/>

            <TextView
                android:id="@+id/tvvt_quntity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="25sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvvt_unitPrice"
                android:layout_marginStart="5dp"
                android:layout_marginTop="20dp"
                android:textColor="@color/black"
                android:text="Quntity:"/>


            <TextView
                android:id="@+id/tvvt_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="25sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvvt_quntity"
                android:layout_marginStart="5dp"
                android:layout_marginTop="20dp"
                android:textColor="@color/black"
                android:text="Total:"/>

        </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.cardview.widget.CardView>


    <Button
        android:id="@+id/btn_thanks"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@drawable/btn_shape_recipt"
        android:text="Thanks"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>





</androidx.constraintlayout.widget.ConstraintLayout>